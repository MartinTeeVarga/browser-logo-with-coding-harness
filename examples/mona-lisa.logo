to polygon :shade :points
  setpencolor :shade
  setpensize 1
  pu
  setpos first :points
  pd
  filled :shade [
    foreach butfirst :points [setpos ?]
  ]
  pu
end

to ovalshape :cx :cy :rx :ry :shade
  setpencolor :shade
  setpensize 1
  pu
  setxy (:cx + :rx) :cy
  pd
  localmake "angle 0
  filled :shade [
    repeat 48 [
      make "angle :angle + 7.5
      setxy (:cx + :rx * cos :angle) (:cy + :ry * sin :angle)
    ]
  ]
  pu
end

to inkline :shade :thick :points
  setpencolor :shade
  setpensize :thick
  pu
  setpos first :points
  pd
  foreach butfirst :points [setpos ?]
  pu
end

cs
