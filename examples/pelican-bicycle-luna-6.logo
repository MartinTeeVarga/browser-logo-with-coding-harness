to polygon :shade :points
  setpencolor :shade
  setpensize 2
  pu
  setpos first :points
  filled :shade [
    foreach butfirst :points [setpos ?]
  ]
  pu
  setpos first :points
  pd
  foreach butfirst :points [setpos ?]
  setpos first :points
  pu
end

to ovalshape :cx :cy :rx :ry :shade
  localmake "angle 0
  setpencolor :shade
  setpensize 2
  pu
  setxy (:cx + :rx) :cy
  filled :shade [
    repeat 48 [
      make "angle :angle + 7.5
      setxy (:cx + (:rx * cos :angle)) (:cy + (:ry * sin :angle))
    ]
  ]
  pu
  setxy (:cx + :rx) :cy
  pd
  make "angle 0
  repeat 48 [
    make "angle :angle + 7.5
    setxy (:cx + (:rx * cos :angle)) (:cy + (:ry * sin :angle))
  ]
  pu
end

to inkline :shade :thick :points
  setpencolor :shade
  setpensize :thick
  pu
  setpos first :points
  pd
  foreach butfirst :points [setpos ?]
  pu
end

to spoke :cx :cy :radius :angle
  inkline [68 77 78] 2 (list
    (list :cx :cy)
    (list
      (:cx + (:radius * cos :angle))
      (:cy + (:radius * sin :angle))
    )
  )
end

