to ovalpath :cx :cy :rx :ry
  setxy (:cx + (:rx * (cos 0))) (:cy + (:ry * (sin 0)))
  repeat 72 [
    setxy (:cx + (:rx * (cos (repcount * 5)))) (:cy + (:ry * (sin (repcount * 5))))
  ]
end

to oval :cx :cy :rx :ry :color
  setpencolor :color
  setpensize 2
  pd
  filled [ovalpath :cx :cy :rx :ry]
  pu
end

to disk :cx :cy :r :color
  oval :cx :cy :r :r :color
end

to bowlbody
  setpencolor [32 12 10]
  setpensize 5
  pd
  filled [
    setpos [-250 24]
    setxy -238 -48
    setxy -205 -139
    setxy -150 -205
    setxy -78 -235
    setxy 0 -244
    setxy 78 -235
    setxy 150 -205
    setxy 205 -139
    setxy 238 -48
    setxy 250 24
    setpos [-250 24]
  ]
  pu
end

to bowlstripe
  setpencolor [100 66 38]
  setpensize 5
  pu
  setpos [-218 -70]
  pd
  setxy -190 -144
  setxy -145 -195
  setxy -85 -218
  setxy 0 -227
  setxy 85 -218
  setxy 145 -195
  setxy 190 -144
  setxy 218 -70
  pu
end

to steam :x :y
  setpencolor [96 96 91]
  setpensize 5
  pu
  setxy :x :y
  pd
  setxy (:x - 12) (:y + 20)
  setxy (:x + 8) (:y + 40)
  setxy (:x + 15) (:y + 61)
  setxy (:x - 2) (:y + 80)
  pu
end

