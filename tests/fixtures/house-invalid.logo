to house
  clearscreen
  ht
  clean

  setpencolor [20 20 20]
  setpc [20 20 20]
  setpensize 2

  ; Ground (long line)
  pu
  setpos -380 -240
  setheading 0
  pd
  fd 760
  pu

  ; House base rectangle (centered)
  setpos -200 -120
  pd
  repeat 2 [
    fd 400
    lt 90
    fd 240
    lt 90
  ]
  pu

  ; Roof (triangle outline)
  setpencolor [15 15 15]
  setpc [15 15 15]
  setpensize 2
  setpos -220 120
  pd
  setheading 0
  fd 40
  lt 60
  fd 240
  lt 120
  fd 240
  lt 60
  fd 40
  pu

  ; Chimney body
  setpencolor [20 20 20]
  setpc [20 20 20]
  setpensize 3
  setpos 90 60
  pd
  repeat 2 [
    fd 60
    lt 90
    fd 180
    lt 90
  ]
  pu

  ; Chimney cap
  setpensize 3
  setpos 80 240
  pd
  setheading 0
  fd 80
  lt 90
  fd 15
  lt 90
  fd 80
  lt 90
  fd 15
  lt 90
  pu

  ; Door
  setpencolor [20 20 20]
  setpc [20 20 20]
  setpensize 2
  setpos -35 -120
  pd
  setheading 90
  repeat 2 [
    fd 70
    lt 90
    fd 140
    lt 90
  ]
  pu

  ; Door inner panel (simple lines)
  setpos -18 -70
  setpencolor [60 40 20]
  setpc [60 40 20]
  setpensize 1
  pd
  setheading 0
  fd 20
  bk 10
  rt 90
  fd 30
  bk 30
  lt 90
  fd 10
  pu

  ; Windows
  setpensize 2
  setpencolor [20 40 80]
  setpc [20 40 80]

  ; Left window
  setpos -150 -20
  pd
  setheading 90
  repeat 2 [
    fd 70
    rt 90
    fd 60
    rt 90
  ]
  pu

  ; Right window
  setpencolor [20 40 80]
  setpc [20 40 80]
  setpos 90 -20
  pd
  setheading 90
  repeat 2 [
    fd 70
    rt 90
    fd 60
    rt 90
  ]
  pu

  ; Smoke (static puffs)
  setpencolor [40 40 40]
  setpc [40 40 40]
  setpensize 2

  ; Anchor around chimney top
  setpos 120 255
  smokePuff 0
  setpos 120 255
  smokePuff 1
  setpos 120 255
  smokePuff 2
  setpos 120 255
  smokePuff 3
end

to smokePuff :i
  localmake "dx (10 * :i)
  localmake "dy (25 * :i)

  pu
  setxy (xcor + :dx) (ycor + :dy)
  pd
  setheading 0

  repeat 3 [
    arc 14 100
    rt 100
  ]

  pu
  bk 8
  rt 12
  fd 8
  pd

  repeat 2 [
    arc 16 120
    rt 60
  ]
  pu
end

house
